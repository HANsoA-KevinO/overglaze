{
 "schema": "overglaze-track-ownership-v1",
 "tracks": {
  "core": {
   "owner": "shared",
   "allowed": [
    "core"
   ]
  },
  "runtime": {
   "owner": "shared",
   "allowed": [
    "core",
    "runtime"
   ]
  },
  "provider": {
   "owner": "shared",
   "allowed": [
    "core",
    "runtime",
    "provider"
   ]
  },
  "viewer": {
   "owner": "controller",
   "allowed": [
    "core",
    "viewer"
   ]
  },
  "controller": {
   "owner": "controller",
   "allowed": [
    "core",
    "runtime",
    "provider",
    "viewer",
    "controller"
   ]
  }
 },
 "rules": [
  "A file's track is its directory; every file under core, runtime, provider, viewer and controller has an entry here.",
  "A translation unit may #include only headers of tracks listed in allowed[its track]; pending_seams are the only exceptions, each with its closing condition, and each must still be a real violation.",
  "No target defined in core/runtime/provider/viewer/controller may link a library or list a source outside its allowed tracks; controller/viewer targets never reach controller_ban.",
  "core, runtime and provider (owner=shared) are linked by every host; change them only with every configured build directory green."
 ],
