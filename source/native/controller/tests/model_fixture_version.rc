// The game manager test program carries this version resource and no
// signature, so a copy of it is the "unsigned synthetic DLL" the model
// classification test reads (file version 310.99.1.0, newer than every
// reviewed model, yet case d: no valid NVIDIA signature). Never loaded as a
// model; nothing else reads it.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 310,99,1,0
PRODUCTVERSION 310,99,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Overglaze game manager test fixture (synthetic, unsigned)"
            VALUE "FileVersion", "310.99.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
